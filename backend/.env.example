# FleetOps Backend - Environment Variables
# Copy this file to .env and fill in the values

# Database
DATABASE_URL="postgresql://USUARIO:PASSWORD@HOST:5432/postgres"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"

# Server
PORT=3001
NODE_ENV=production
CORS_ORIGIN="https://fleetops-six.vercel.app"

# Telegram Bot (optional - system works without it, errors are logged)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Frontend URL (for password reset emails in the future)
FRONTEND_URL="https://fleetops-six.vercel.app"
