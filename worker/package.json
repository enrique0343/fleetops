{
  "name": "fleetops-worker",
  "version": "1.0.0",
  "private": true,
  "description": "FleetOps API - Cloudflare Worker (Hono + Prisma + D1)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "prisma generate && wrangler deploy",
    "db:generate": "prisma generate",
    "db:diff": "prisma migrate diff --from-empty --to-schema-datamodel ./prisma/schema.prisma --script --output migrations/0001_init.sql",
    "db:migrate:local": "wrangler d1 migrations apply fleetops --local",
    "db:migrate:remote": "wrangler d1 migrations apply fleetops --remote",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@prisma/adapter-d1": "^5.22.0",
    "@prisma/client": "^5.22.0",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "prisma": "^5.22.0",
    "typescript": "^5.6.3",
    "wrangler": "^3.91.0"
  }
}
