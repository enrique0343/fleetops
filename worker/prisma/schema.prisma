// FleetOps - Prisma Schema (Cloudflare D1 / SQLite)
// Corporate Transport Management System
//
// NOTE: SQLite does not support native enums or the Json scalar.
//   - Former enums are stored as String (allowed values noted in comments).
//   - Former Json fields are stored as String (JSON-encoded text); the
//     application layer (src/lib/json.ts) encodes/decodes them.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// USER & AUTH
// ─────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  role         String   @default("DRIVER") // DRIVER | ADMIN | REQUESTER | DISPATCHER
  phone        String?
  department   String?
  photoUrl     String?  @map("photo_url") // foto de perfil (data URL JPEG reducido)
  isActive     Boolean  @default(true) @map("is_active")
  branchId     String?  @map("branch_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  branch Branch? @relation(fields: [branchId], references: [id])

  tripsAsDriver     Trip[]             @relation("DriverTrips")
  tripEvents        TripEvent[]
  fuelRecords       FuelRecord[]
  auditLogs         AuditLog[]
  passwordResets    PasswordReset[]
  requestsMade      TransportRequest[] @relation("RequesterRequests")
  requestsAssigned  TransportRequest[] @relation("AssignedDriverRequests")
  requestsApproved  TransportRequest[] @relation("ApproverRequests")
  requestEvents     RequestEvent[]
  scheduleBlocks    ScheduleBlock[]
  routePlans        RoutePlan[]

  @@map("users")
}

model PasswordReset {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("password_resets")
}

// ─────────────────────────────────────────────
// CATALOGS
// ─────────────────────────────────────────────

model Branch {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  address   String?
  lat       Float? // coordenadas para autodetección de sucursal por GPS
  lng       Float?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users          User[]
  vehicles       Vehicle[]
  locations      Location[]
  tripsOrigin    Trip[]          @relation("OriginBranch")
  tripsClosure   Trip[]          @relation("ClosureBranch")
  fuelRecords    FuelRecord[]
  serviceWindows ServiceWindow[]

  @@map("branches")
}

model Location {
  id          String   @id @default(uuid())
  name        String
  type        String   @default("DESTINATION") // BRANCH | DESTINATION | OPERATIONAL | OTHER
  branchId    String?  @map("branch_id")
  description String?
  addressRef  String?  @map("address_ref")
  lat         Float?
  lng         Float?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  branch           Branch? @relation(fields: [branchId], references: [id])
  trips            Trip[]  @relation("TripDestination")
  requestsOrigin   TransportRequest[] @relation("RequestOrigin")
  requestsDest     TransportRequest[] @relation("RequestDestination")
  tasks            TransportTask[]

  @@map("locations")
}

model Vehicle {
  id            String   @id @default(uuid())
  plate         String   @unique
  model         String
  brand         String
  year          Int?
  vehicleType   String?  @map("vehicle_type")
  serviceClass  String   @default("ADMIN") @map("service_class") // ADMIN | AMBULANCE | CARGO
  branchId      String?  @map("branch_id")
  fuelType      String?  @map("fuel_type")
  color         String?
  isActive      Boolean  @default(true) @map("is_active")
  currentTripId String?  @unique @map("current_trip_id")
  photoUrl      String?  @map("photo_url") // foto de la unidad (data URL JPEG reducido)

  // Ambulance capabilities
  isAmbulance   Boolean  @default(false) @map("is_ambulance")
  hasStretcher  Boolean  @default(false) @map("has_stretcher")
  hasOxygen     Boolean  @default(false) @map("has_oxygen")

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  branch        Branch?            @relation(fields: [branchId], references: [id])
  trips         Trip[]
  fuelRecords   FuelRecord[]
  requests      TransportRequest[]
  scheduleBlocks ScheduleBlock[]
  routePlans    RoutePlan[]

  @@map("vehicles")
}

model IncidentType {
  id          String   @id @default(uuid())
  name        String
  description String?
  severity    String   @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("incident_types")
}

// ─────────────────────────────────────────────
// TRIPS
// ─────────────────────────────────────────────

model Trip {
  id              String  @id @default(uuid())
  driverId        String  @map("driver_id")
  vehicleId       String  @map("vehicle_id")
  originBranchId  String? @map("origin_branch_id") // opcional: el origen real es el GPS de inicio
  destinationId   String  @map("destination_id")
  closureBranchId String? @map("closure_branch_id")

  status      String  @default("IN_TRANSIT") // IN_TRANSIT | IN_STOP | IN_INCIDENT | FINISHED | CANCELLED
  closureType String? @map("closure_type") // NORMAL | FORCED | ADMIN_CORRECTION

  startedAt       DateTime  @map("started_at")
  finishedAt      DateTime? @map("finished_at")
  durationMinutes Int?      @map("duration_minutes")

  startLat Float? @map("start_lat")
  startLng Float? @map("start_lng")
  endLat   Float? @map("end_lat")
  endLng   Float? @map("end_lng")
  endPlace String? @map("end_place") // nombre del lugar de llegada (reverse geocoding)

  // Última posición reportada por el conductor (ping periódico durante el viaje)
  lastLat    Float?    @map("last_lat")
  lastLng    Float?    @map("last_lng")
  lastPingAt DateTime? @map("last_ping_at")

  comment         String?
  correctionFlag  Boolean @default(false) @map("correction_flag")
  forcedCloseFlag Boolean @default(false) @map("forced_close_flag")

  telegramDeliveryStatus String    @default("PENDING") @map("telegram_delivery_status") // PENDING | SENT | FAILED | NOT_CONFIGURED
  telegramLastAttemptAt  DateTime? @map("telegram_last_attempt_at")
  telegramLastResult     String?   @map("telegram_last_result")

  // Planning links (optional — null = ad-hoc trip)
  requestId String? @unique @map("request_id") // originating TransportRequest
  priority  String  @default("NORMAL")         // NORMAL | URGENT | EMERGENCY

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  driver        User         @relation("DriverTrips", fields: [driverId], references: [id])
  vehicle       Vehicle      @relation(fields: [vehicleId], references: [id])
  originBranch  Branch?      @relation("OriginBranch", fields: [originBranchId], references: [id])
  destination   Location     @relation("TripDestination", fields: [destinationId], references: [id])
  closureBranch Branch?      @relation("ClosureBranch", fields: [closureBranchId], references: [id])
  events        TripEvent[]
  fuelRecords   FuelRecord[]
  request       TransportRequest? @relation(fields: [requestId], references: [id])
  routePlan     RoutePlan?
  tasks         TransportTask[]
  trackPoints   TripTrackPoint[]

  @@map("trips")
}

// Breadcrumb del recorrido: un punto por cada ping del conductor.
// Permite dibujar la ruta real recorrida (trazabilidad visual).
model TripTrackPoint {
  id         String   @id @default(uuid())
  tripId     String   @map("trip_id")
  lat        Float
  lng        Float
  recordedAt DateTime @default(now()) @map("recorded_at")

  trip Trip @relation(fields: [tripId], references: [id])

  @@index([tripId, recordedAt])
  @@map("trip_track_points")
}

model TripEvent {
  id              String   @id @default(uuid())
  tripId          String   @map("trip_id")
  type            String // START_TRIP | ARRIVE_STOP | RESUME_TRIP | REPORT_INCIDENT | FINISH_TRIP | FORCE_CLOSE | ADMIN_CORRECTION | TELEGRAM_SENT | TELEGRAM_FAILED | FUEL_REGISTERED
  userId          String   @map("user_id")
  deviceTimestamp DateTime @map("device_timestamp")
  serverTimestamp DateTime @default(now()) @map("server_timestamp")
  comment         String?
  metadata        String? // JSON-encoded

  trip Trip @relation(fields: [tripId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@map("trip_events")
}

// ─────────────────────────────────────────────
// FUEL
// ─────────────────────────────────────────────

model FuelRecord {
  id        String  @id @default(uuid())
  vehicleId String  @map("vehicle_id")
  driverId  String  @map("driver_id")
  tripId    String? @map("trip_id")
  branchId  String? @map("branch_id")

  stationName     String  @map("station_name")
  fuelType        String  @map("fuel_type")
  quantity        Float
  unit            String  @default("LITERS") // LITERS | GALLONS
  totalAmount     Float   @map("total_amount")
  currency        String  @default("USD")
  odometerKm      Float?  @map("odometer_km")
  paymentMethod   String? @map("payment_method")
  receiptNumber   String? @map("receipt_number")
  isFullTank      Boolean @default(true) @map("is_full_tank")
  observation     String?
  receiptPhotoUrl String? @map("receipt_photo_url")

  correctedBy    String?   @map("corrected_by")
  correctionNote String?   @map("correction_note")
  correctedAt    DateTime? @map("corrected_at")

  recordedAt DateTime @map("recorded_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  driver  User    @relation(fields: [driverId], references: [id])
  trip    Trip?   @relation(fields: [tripId], references: [id])
  branch  Branch? @relation(fields: [branchId], references: [id])

  @@map("fuel_records")
}

// ─────────────────────────────────────────────
// AUDIT
// ─────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  entityName String   @map("entity_name")
  entityId   String   @map("entity_id")
  adminId    String   @map("admin_id")
  action     String
  oldValue   String?  @map("old_value") // JSON-encoded
  newValue   String?  @map("new_value") // JSON-encoded
  reason     String?
  timestamp  DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id])

  @@map("audit_logs")
}

// ─────────────────────────────────────────────
// TRANSPORT REQUESTS (Appointments)
// ─────────────────────────────────────────────

model TransportRequest {
  id          String @id @default(uuid())
  code        String @unique
  serviceType String @default("STANDARD") // STANDARD | AMBULANCE
  priority    String @default("SCHEDULED") // SCHEDULED | URGENT | EMERGENCY
  status      String @default("PENDING") // PENDING | APPROVED | REJECTED | SCHEDULED | RESCHEDULED | DISPATCHED | COMPLETED | CANCELLED | NO_SHOW

  // Requester
  requesterId    String? @map("requester_id")
  requesterName  String  @map("requester_name")
  requesterEmail String? @map("requester_email")
  requesterPhone String? @map("requester_phone")
  requesterDept  String? @map("requester_dept")

  // Route & schedule
  originId         String  @map("origin_id")
  destinationId    String  @map("destination_id")
  scheduledAt      DateTime @map("scheduled_at")
  windowMinutes    Int      @default(30) @map("window_minutes")
  estimatedMinutes Int?     @map("estimated_minutes")

  // Standard payload
  passengerCount Int?    @map("passenger_count")
  reason         String?

  // Ambulance / clinical block (optional)
  patientName       String?  @map("patient_name")
  patientCondition  String?  @map("patient_condition")
  requiresStretcher Boolean  @default(false) @map("requires_stretcher")
  requiresOxygen    Boolean  @default(false) @map("requires_oxygen")
  clinicalNotes     String?  @map("clinical_notes")

  // Assignment
  assignedVehicleId String?   @map("assigned_vehicle_id")
  assignedDriverId  String?   @map("assigned_driver_id")
  approvedById      String?   @map("approved_by_id")
  approvedAt        DateTime? @map("approved_at")
  rejectionReason   String?   @map("rejection_reason")

  // Execution
  tripId       String?   @unique @map("trip_id")
  dispatchedAt DateTime? @map("dispatched_at")
  completedAt  DateTime? @map("completed_at")

  // SLA
  slaTargetAt DateTime? @map("sla_target_at")
  slaMetFlag  Boolean?  @map("sla_met_flag")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  requester       User?     @relation("RequesterRequests", fields: [requesterId], references: [id])
  origin          Location  @relation("RequestOrigin", fields: [originId], references: [id])
  destination     Location  @relation("RequestDestination", fields: [destinationId], references: [id])
  assignedVehicle Vehicle?  @relation(fields: [assignedVehicleId], references: [id])
  assignedDriver  User?     @relation("AssignedDriverRequests", fields: [assignedDriverId], references: [id])
  approvedBy      User?     @relation("ApproverRequests", fields: [approvedById], references: [id])
  trip            Trip?
  events          RequestEvent[]
  referrals       ExternalReferral[]

  @@map("transport_requests")
}

model RequestEvent {
  id        String   @id @default(uuid())
  requestId String   @map("request_id")
  type      String // CREATED | APPROVED | REJECTED | ASSIGNED | RESCHEDULED | DISPATCHED | COMPLETED | CANCELLED | NO_SHOW | EMERGENCY_OVERRIDE | REFERRED_EXTERNAL
  userId    String?  @map("user_id")
  comment   String?
  metadata  String? // JSON-encoded
  createdAt DateTime @default(now()) @map("created_at")

  request TransportRequest @relation(fields: [requestId], references: [id])
  user    User?            @relation(fields: [userId], references: [id])

  @@map("request_events")
}

// ─────────────────────────────────────────────
// SCHEDULING / AVAILABILITY
// ─────────────────────────────────────────────

model ServiceWindow {
  id          String  @id @default(uuid())
  serviceType String  @map("service_type") // STANDARD | AMBULANCE
  branchId    String? @map("branch_id")
  dayOfWeek   Int     @map("day_of_week") // 0=Sun .. 6=Sat
  startTime   String  @map("start_time") // "08:00"
  endTime     String  @map("end_time") // "17:00"
  slotMinutes Int     @default(30) @map("slot_minutes")
  isActive    Boolean @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  branch Branch? @relation(fields: [branchId], references: [id])

  @@map("service_windows")
}

model ScheduleBlock {
  id           String   @id @default(uuid())
  resourceType String   @map("resource_type") // VEHICLE | DRIVER
  vehicleId    String?  @map("vehicle_id")
  driverId     String?  @map("driver_id")
  reason       String // MAINTENANCE | SHIFT | OFF | RESERVED | OTHER
  startAt      DateTime @map("start_at")
  endAt        DateTime @map("end_at")
  note         String?
  createdById  String   @map("created_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  vehicle Vehicle? @relation(fields: [vehicleId], references: [id])
  driver  User?    @relation(fields: [driverId], references: [id])

  @@map("schedule_blocks")
}

// ─────────────────────────────────────────────
// OUTSOURCING (External providers)
// ─────────────────────────────────────────────

model ExternalProvider {
  id           String  @id @default(uuid())
  name         String
  serviceType  String  @default("AMBULANCE") @map("service_type") // AMBULANCE | STANDARD | BOTH
  phone        String?
  contactName  String? @map("contact_name")
  coverageNote String? @map("coverage_note")
  isActive     Boolean @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  referrals ExternalReferral[]

  @@map("external_providers")
}

model ExternalReferral {
  id           String  @id @default(uuid())
  requestId    String? @map("request_id")
  serviceType  String  @map("service_type")
  providerId   String? @map("provider_id")
  providerName String  @map("provider_name")
  reason       String // NO_UNIT | OUT_OF_HOURS | ALL_BUSY | OTHER
  patientName  String? @map("patient_name")
  notes        String?
  status       String  @default("REFERRED") // REFERRED | CONFIRMED | CANCELLED
  referredById String  @map("referred_by_id")
  referredAt   DateTime @default(now()) @map("referred_at")

  request  TransportRequest? @relation(fields: [requestId], references: [id])
  provider ExternalProvider? @relation(fields: [providerId], references: [id])

  @@map("external_referrals")
}

// ─────────────────────────────────────────────
// TASK POOL & ROUTING
// ─────────────────────────────────────────────

model TransportTask {
  id             String    @id @default(uuid())
  code           String    @unique
  type           String    @default("DELIVERY") // DROPOFF | PICKUP | DELIVERY | VISIT
  requesterId    String?   @map("requester_id")
  requesterName  String    @map("requester_name")
  locationId     String?   @map("location_id")
  addressText    String?   @map("address_text")
  lat            Float?
  lng            Float?
  notes          String?
  priority       String    @default("NORMAL") // NORMAL | HIGH
  windowStart    DateTime? @map("window_start")
  windowEnd      DateTime? @map("window_end")
  serviceTimeMin Int       @default(5) @map("service_time_min")
  status         String    @default("POOL") // POOL | ASSIGNED | EN_ROUTE | DONE | CANCELLED
  routeId        String?   @map("route_id")
  tripId         String?   @map("trip_id")
  sortOrder      Int?      @map("sort_order")
  createdAt      DateTime  @default(now()) @map("created_at")

  location Location?  @relation(fields: [locationId], references: [id])
  route    RoutePlan? @relation(fields: [routeId], references: [id])
  trip     Trip?      @relation(fields: [tripId], references: [id])

  @@map("transport_tasks")
}

model RoutePlan {
  id               String   @id @default(uuid())
  code             String   @unique
  driverId         String?  @map("driver_id")
  vehicleId        String?  @map("vehicle_id")
  status           String   @default("DRAFT") // DRAFT | DISPATCHED | IN_PROGRESS | DONE
  plannedDate      DateTime @map("planned_date")
  totalDistanceKm  Float?   @map("total_distance_km")
  totalDurationMin Int?     @map("total_duration_min")
  optimizedOrder   String?  @map("optimized_order") // JSON-encoded [taskId,...]
  optimizerMeta    String?  @map("optimizer_meta") // JSON-encoded
  tripId           String?  @unique @map("trip_id")
  createdById      String   @map("created_by_id")
  createdAt        DateTime @default(now()) @map("created_at")

  driver  User?           @relation(fields: [driverId], references: [id])
  vehicle Vehicle?        @relation(fields: [vehicleId], references: [id])
  trip    Trip?           @relation(fields: [tripId], references: [id])
  tasks   TransportTask[]

  @@map("route_plans")
}
